! SW1 Configuration - Campus A Access Switch 1
! ===========================================

version 15.0
service timestamps debug datetime msec
service timestamps log datetime msec
no service password-encryption
!
hostname SW1-CAMPUS-A
!
boot-start-marker
boot-end-marker
!
!
no aaa new-model
!
!
no ip domain lookup
ip domain name globalcorp.local
!
!
username admin privilege 15 secret 5 $1$mERr$9cTjUIEqNGurQiFU.ZeCi1
!
!
crypto key generate rsa general-keys modulus 1024
ip ssh version 2
ip ssh time-out 60
ip ssh authentication-retries 3
!
!
vlan 5
 name SOC_Team
!
vlan 6
 name Network_Engineers
!
vlan 7
 name System_Administrator
!
vlan 8
 name IT_Support
!
vlan 100
 name Default_VLAN
!
vlan 999
 name Native_Trunk_VLAN
!
interface FastEthernet0/1
 description Trunk to L3-SW0
 switchport mode trunk
 switchport trunk native vlan 999
 switchport trunk allowed vlan 5-8,100
 spanning-tree portfast trunk
 no shutdown
!
interface FastEthernet0/2
 description Trunk to L3-SW1
 switchport mode trunk
 switchport trunk native vlan 999
 switchport trunk allowed vlan 5-8,100
 spanning-tree portfast trunk
 no shutdown
!
interface range FastEthernet0/5-8
 description SOC Team VLAN devices
 switchport mode access
 switchport access vlan 5
 switchport port-security
 switchport port-security maximum 3
 switchport port-security violation restrict
 switchport port-security aging time 10
 switchport port-security aging type inactivity
 spanning-tree portfast
 no shutdown
!
interface range FastEthernet0/10-12
 description Network Engineers VLAN devices
 switchport mode access
 switchport access vlan 6
 switchport port-security
 switchport port-security maximum 3
 switchport port-security violation restrict
 switchport port-security aging time 10
 switchport port-security aging type inactivity
 spanning-tree portfast
 no shutdown
!
interface range FastEthernet0/15-16
 description System Administrator VLAN devices
 switchport mode access
 switchport access vlan 7
 switchport port-security
 switchport port-security maximum 3
 switchport port-security violation restrict
 switchport port-security aging time 10
 switchport port-security aging type inactivity
 spanning-tree portfast
 no shutdown
!
interface range FastEthernet0/20-23
 description IT Support VLAN devices
 switchport mode access
 switchport access vlan 8
 switchport port-security
 switchport port-security maximum 3
 switchport port-security violation restrict
 switchport port-security aging time 10
 switchport port-security aging type inactivity
 spanning-tree portfast
 no shutdown
!
interface range FastEthernet0/3-4, FastEthernet0/9, FastEthernet0/13-14, FastEthernet0/17-19, FastEthernet0/24
 description Unused Port - DISABLED
 shutdown
 switchport mode access
 switchport access vlan 100
!
interface Vlan2
 description Management VLAN
 ip address 10.10.2.5 255.255.255.0
 no shutdown
!
ip default-gateway 10.10.2.1
!
ip forward-protocol nd
!
no ip http server
no ip http secure-server
!
!
spanning-tree mode rapid-pvst
spanning-tree extend system-id
spanning-tree vlan 5-8,100 priority 40960
!
ip dhcp snooping
ip dhcp snooping vlan 5-8
no ip dhcp snooping information option
!
banner motd $
****************************************************************
*  WARNING: UNAUTHORIZED ACCESS IS FORBIDDEN                   *
*  This system is for authorized users only.                   *
*  All activities are logged and monitored.                    *
*  Violators will be prosecuted to the fullest extent.         *
****************************************************************
$
!
line con 0
 logging synchronous
 exec-timeout 5 0
line vty 0 4
 transport input ssh
 login local
 exec-timeout 5 0
 logging synchronous
line vty 5 15
 transport input ssh
 login local
 exec-timeout 5 0
 logging synchronous
!
!
end
