! SW2 Configuration - Campus A Access Switch 2
! ===========================================

version 15.0
service timestamps debug datetime msec
service timestamps log datetime msec
no service password-encryption
!
hostname SW2-CAMPUS-A
!
boot-start-marker
boot-end-marker
!
!
no aaa new-model
!
!
no ip domain lookup
ip domain name globalcorp.local
!
!
username admin privilege 15 secret 5 $1$mERr$9cTjUIEqNGurQiFU.ZeCi1
!
!
crypto key generate rsa general-keys modulus 1024
ip ssh version 2
ip ssh time-out 60
ip ssh authentication-retries 3
!
!
vlan 9
 name Team_Lead
!
vlan 10
 name BackEnd_Developers
!
vlan 11
 name FrontEnd_Developers
!
vlan 12
 name Data_Scientists
!
vlan 100
 name Default_VLAN
!
vlan 999
 name Native_Trunk_VLAN
!
interface FastEthernet0/1
 description Trunk to L3-SW0
 switchport mode trunk
 switchport trunk native vlan 999
 switchport trunk allowed vlan 9-12,100
 spanning-tree portfast trunk
 no shutdown
!
interface FastEthernet0/2
 description Trunk to L3-SW1
 switchport mode trunk
 switchport trunk native vlan 999
 switchport trunk allowed vlan 9-12,100
 spanning-tree portfast trunk
 no shutdown
!
interface range FastEthernet0/5-7
 description Team Lead VLAN devices
 switchport mode access
 switchport access vlan 9
 switchport port-security
 switchport port-security maximum 3
 switchport port-security violation restrict
 switchport port-security aging time 10
 switchport port-security aging type inactivity
 spanning-tree portfast
 no shutdown
!
interface range FastEthernet0/10-12
 description BackEnd Developers VLAN devices
 switchport mode access
 switchport access vlan 10
 switchport port-security
 switchport port-security maximum 3
 switchport port-security violation restrict
 switchport port-security aging time 10
 switchport port-security aging type inactivity
 spanning-tree portfast
 no shutdown
!
interface range FastEthernet0/15-19
 description FrontEnd Developers VLAN devices
 switchport mode access
 switchport access vlan 11
 switchport port-security
 switchport port-security maximum 3
 switchport port-security violation restrict
 switchport port-security aging time 10
 switchport port-security aging type inactivity
 spanning-tree portfast
 no shutdown
!
interface range FastEthernet0/20-21
 description Data Scientists VLAN devices
 switchport mode access
 switchport access vlan 12
 switchport port-security
 switchport port-security maximum 3
 switchport port-security violation restrict
 switchport port-security aging time 10
 switchport port-security aging type inactivity
 spanning-tree portfast
 no shutdown
!
interface range FastEthernet0/3-4, FastEthernet0/8-9, FastEthernet0/13-14, FastEthernet0/22-24
 description Unused Port - DISABLED
 shutdown
 switchport mode access
 switchport access vlan 100
!
interface Vlan2
 description Management VLAN
 ip address 10.10.2.6 255.255.255.0
 no shutdown
!
ip default-gateway 10.10.2.1
!
ip forward-protocol nd
!
no ip http server
no ip http secure-server
!
!
spanning-tree mode rapid-pvst
spanning-tree extend system-id
spanning-tree vlan 9-12,100 priority 40960
!
ip dhcp snooping
ip dhcp snooping vlan 9-12
no ip dhcp snooping information option
!
banner motd $
****************************************************************
*  WARNING: UNAUTHORIZED ACCESS IS FORBIDDEN                   *
*  This system is for authorized users only.                   *
*  All activities are logged and monitored.                    *
*  Violators will be prosecuted to the fullest extent.         *
****************************************************************
$
!
line con 0
 logging synchronous
 exec-timeout 5 0
line vty 0 4
 transport input ssh
 login local
 exec-timeout 5 0
 logging synchronous
line vty 5 15
 transport input ssh
 login local
 exec-timeout 5 0
 logging synchronous
!
!
end
